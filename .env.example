# TAO Configuration
# Copy this file to .env and fill in your values

# LLM API Keys (optional — simulation mode works without these)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Mode: set to "true" for demo without API calls
SIMULATION_MODE=true

# Tier Thresholds
TIER1_SAFETY_THRESHOLD=0.95
TIER2_MAX_DEBATE_ROUNDS=3
TIER2_JUDGE_CONFIDENCE_THRESHOLD=0.9

# Steganography Detection
TIER3_KL_DIVERGENCE_THRESHOLD=0.15
TIER3_CREATIVE_KL_THRESHOLD=0.35

# Server
HOST=0.0.0.0
PORT=8000
